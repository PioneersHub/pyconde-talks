###############################################
# Docker Compose environment for the web app  #
###############################################

# Build with Bake
COMPOSE_BAKE=true
DOCKER_PLATFORM=linux/amd64
CONTAINER_PREFIX=XXX_APP_DOMAIN_XXX
IMAGE_NAME=XXX_APP_DOMAIN_XXX-django
IMAGE_TAG=latest

# Database (service: db)
POSTGRES_USER=XXX_PG_USER_XXX
POSTGRES_PASSWORD=XXX_PG_PASS_XXX
POSTGRES_DB=XXX_PG_DB_XXX
DATABASE_URL=postgres://XXX_PG_USER_XXX:XXX_PG_PASS_XXX@db:5432/XXX_PG_DB_XXX
# Persistent connections (seconds).
# 0 = open/close per request; higher avoids the Postgres connect handshake on every request behind
# Daphne / gunicorn / etc.
# Ignored when DJANGO_DB_POOL=True - the pool manages connection lifetime.
DJANGO_CONN_MAX_AGE=60
# Detect and replace stale persistent connections.
DJANGO_CONN_HEALTH_CHECKS=True
# Use Django's native psycopg3 connection pool. Postgres-only.
# Keep this False under Daphne/ASGI: the in-process pool defaults to only 4 connections and does not
# reliably return them under async, so a burst exhausts it and every request 500s with PoolTimeout
# until restart. Use CONN_MAX_AGE or an external pooler (PgBouncer) instead.
DJANGO_DB_POOL=False

# Coarse per-IP ceiling on login-code requests, on top of the per-email limit. Public events
# accept any address, so the per-email key alone does not bound a script walking a list of them.
# The venue reaches the site through one NAT address, so keep this well above the opening-session
# rush: it is there to make bulk signup pointless, not to throttle real attendees.
LOGIN_CODE_IP_RATE_LIMIT=60/5m/ip

# Q&A anti-spam. Limits are per user account, never per IP: the venue's ~2000 attendees share
# one NAT address. Generous on purpose - an engaged attendee asks one to three questions during
# a talk, so these only catch flooding. Windows are in seconds.
QA_QUESTION_RATE_LIMIT_PER_TALK=5
QA_QUESTION_RATE_WINDOW_PER_TALK=600
QA_QUESTION_RATE_LIMIT_OVERALL=20
QA_QUESTION_RATE_WINDOW_OVERALL=3600
# Extra words that send a question to the moderation queue. Empty by default; add terms only if
# a specific spam campaign turns up, since keyword lists date badly.
QA_SPAM_KEYWORDS=

# Cloudflare Turnstile on the question form. Both keys required to enable it; create the widget
# at dash.cloudflare.com -> Turnstile. Left blank on purpose, unlike the XXX_..._XXX placeholders
# elsewhere in this file: the captcha is optional, and blank is what switches it off. A leftover
# placeholder here would read as configured and send every question to Cloudflare with a secret
# it rejects, which is a far more puzzling failure than simply not having a captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5
# Allow submissions through when Cloudflare cannot be reached: an outage should not take the
# conference Q&A down with it.
TURNSTILE_FAIL_OPEN=true

# Cache (service: redis)
# Shared across workers, which the Q&A rate limiter needs: on a per-process cache the allowance
# would silently become "limit x number of workers". The allauth OAuth bearer token is cached
# here too. Cache-only, so the container runs with persistence disabled.
DJANGO_CACHE_URL=redis://redis:6379/0

# Cache-busted static asset URLs via a hashed manifest. Far-future Cache-Control headers
# at the nginx layer stay safe across deploys.
DJANGO_STATICFILES_STORAGE=django.contrib.staticfiles.storage.ManifestStaticFilesStorage

# General
DJANGO_SETTINGS_MODULE=event_talks.settings
DJANGO_READ_VARS_FILE=false
SITE_ID=1
DJANGO_DEBUG=false

# Internationalization
# Default/source language. One of settings.LANGUAGES.
LANGUAGE_CODE=en
TIME_ZONE=Europe/Berlin
USE_I18N=true
USE_TZ=true

# Security
DJANGO_ALLOWED_HOSTS="talks.example.com,127.0.0.1"
DJANGO_CSRF_TRUSTED_ORIGINS="https://talks.example.com,http://127.0.0.1,http://localhost"
DJANGO_SECRET_KEY=XXX_DJ_SECRET_XXX
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Language switcher cookie (django_language). True in prod (HTTPS); False in local dev.
LANGUAGE_COOKIE_SECURE=true
# HSTS: instruct browsers to only connect via HTTPS for 1 year
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
DATA_UPLOAD_MAX_NUMBER_FIELDS=3000

# Admin
ADMIN_NAMES="XXX_ADMIN_NAMES_XXX"
ADMIN_EMAILS="XXX_ADMIN_EMAILS_XXX"
DJANGO_ADMIN_URL=admin/

# Authentication / Allauth
ACCOUNT_LOGIN_BY_CODE_TIMEOUT=300
# Trusted reverse-proxy hops (1 for the bundled nginx), so allauth derives the real client IP
# from X-Forwarded-For for correct IP attribution in logs. Auth rate limits are keyed per
# account, not per IP (a shared venue NAT IP would otherwise let one attendee lock everyone
# out), so this only affects logging. Must match your proxy topology.
ALLAUTH_TRUSTED_PROXY_COUNT=1
ACCOUNT_EMAIL_SUBJECT_PREFIX="[XXX_EVENT_NAME_XXX XXX_YEAR_XXX] "

# Email validation API
EMAIL_VALIDATION_API_URL_FALLBACK=
EMAIL_VALIDATION_API_TIMEOUT=10
AUTHORIZED_EMAILS_WHITELIST=

# OAuth2 client credentials for the validation API
# All three are required to enable OAuth2 authentication on validation API calls.
EMAIL_VALIDATION_API_OAUTH2_CLIENT_ID=
EMAIL_VALIDATION_API_OAUTH2_CLIENT_SECRET=
EMAIL_VALIDATION_API_OAUTH2_TOKEN_URL=

# Discord
DISCORD_CLIENT_ID=XXXXXXXXXXXXXXXXXXX
DISCORD_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_API_TIMEOUT=5
DISCORD_GUILD_ID=XXXXXXXXXXXXXXXXXX
DISCORD_ROLES='{"everyone":"AAAAA";"attendee":"BBBBB";"organiser":"CCCCC";"session_chair":"DDDDD";"volunteer":"EEEEE"}'
DISCORD_ALLOWED_ROLES=attendee,organiser,session_chair,volunteer
DISCORD_ADMIN_ROLES=organiser
DISCORD_STAFF_ROLES=session_chair

# Session chairing
CHAIR_ROOM_TRANSITION_MINUTES=5

# Static and media files
DJANGO_STATIC_ROOT=/staticfiles
DJANGO_STATIC_URL=static/
# Static dirs are used only during collectstatic
DJANGO_STATICFILES_DIRS=
DJANGO_MEDIA_ROOT=/var/opt/XXX_APP_DOMAIN_XXX/media/
DJANGO_MEDIA_URL=/media/
MOUNT_MEDIA_ROOT=/var/opt/XXX_APP_DOMAIN_XXX/media/

# Email settings
DJANGO_EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Talks <talks@example.de>
SERVER_EMAIL=root@localhost
MAILGUN_API_KEY=XXX_MG_API_KEY_XXX
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=XXX_MG_DOMAIN_XXX

# Branding / Event configuration
DEFAULT_EVENT=XXX_EVENT_SLUG_XXX

# Pretalx
PRETALX_API_TOKEN=XXX_PRETALX_API_TOKEN_XXX
PICKLE_PRETALX_TALKS=False
# Recipients of the post-detect summary email (see docs/pretalx-sync.md). Empty value =
# fall back to ADMIN_EMAILS. Set to "-" to disable the digest entirely.
PRETALX_DIGEST_RECIPIENTS=

# Fonts
TALK_CARD_FONT="/usr/share/fonts/truetype/noto/NotoSans.ttf"

# Livestreams
LIVESTREAMS_SHEET_ID=XXX_LS_SHEET_ID_XXX
LIVESTREAMS_WORKSHEET_NAME=XXX_LS_WORKSHEET_NAME_XXX

# Vimeo
VIMEO_ACCESS_TOKEN=XXX_VIMEO_AT_XXX
VIMEO_PROJECT_IDS=XXXX,YYYY

# Feature flags
SHOW_UPCOMING_TALKS_LINKS=False
IMPORT_TALKS_WITHOUT_SPEAKERS=True

# Logging
LOG_EMAIL_HASH=False
DJANGO_LOGS_DIR=/logs/
MOUNT_LOGS_DIR=/var/log/XXX_APP_DOMAIN_XXX/
DJANGO_DATABASE_LOG_LEVEL=ERROR
LOG_LEVEL=INFO

# Sentry alerting (https://docs.sentry.io/platforms/python/integrations/django/)
# Leave SENTRY_DSN blank to disable.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_SEND_DEFAULT_PII=False
